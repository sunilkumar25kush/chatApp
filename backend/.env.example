# ── Backend environment (copy to .env and fill real values) ──────────
PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas or local)
# Atlas example: mongodb+srv://<username>:<password>@<cluster-host>/chat_application
MONGO_URI=mongodb://127.0.0.1:27017/chat_application

# Strong random secret — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production there is NO fallback: missing JWT_SECRET crashes the server on boot (intentional).
JWT_SECRET=change_me_to_a_long_random_string

# Frontend origin (CORS allowlist)
CLIENT_URL=http://localhost:5173

# ── Cloudinary (optional — file uploads). Leave empty to store uploads locally in /uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── LiveKit SFU Configuration (Multi-user voice & video calls) ─────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_32_character_development_key_livekit

